    "dedent": "^0.7.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.6",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "globby": "11.1.0",
    "husky": "^9.1.7",
