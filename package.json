    "gray-matter": "^4.0.3",
    "image-size": "^1.2.1",
    "mdast-util-to-string": "^4.0.0",
    "mdx-bundler": "^10.1.1",
    "next": "^15.5.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.28",
